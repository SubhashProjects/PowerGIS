  "description": "PowerGIS Enterprise Electricity Distribution GIS & Asset Management Platform \u2014 Completion & Stabilization",
  "author": "PowerGIS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare_build.js && vite",
    "build": "node scripts/prepare_build.js && tsc && vite build && node scripts/sync_dist.js",
    "preview": "vite preview",
    "test": "npx tsx tests/security_and_functional.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "audit": "node scripts/platform_audit.mjs",
    "test:static": "node scripts/platform_audit.mjs && node scripts/run_static_tests.mjs && node scripts/release_readiness_audit.mjs",
    "test:platform-runtime": "npx tsx --test tests/v3_32_platform_evolution.runtime.test.ts",
    "release:audit": "node scripts/release_readiness_audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2"
}
