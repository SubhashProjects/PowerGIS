# Public Supabase configuration injected at build time.
# These values are visible to browser users; never put service-role or gateway secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Configure this as a Supabase Edge Function secret, not as a VITE_ variable.
# Comma-separated exact browser origins; wildcard origins are not accepted.
POWERGIS_ALLOWED_ORIGINS=https://your-production-host.example
